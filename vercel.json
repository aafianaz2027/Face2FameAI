{
  "version": 2,
  "functions": {
    "backend/app.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,node_modules/**,frontend/node_modules/**,.venv/**,backend/.venv/**,backend/uploads/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/build/static/$1"
    },
    {
      "src": "/(.*\\.(js|css|json|ico|png|jpg|jpeg|svg|txt|webmanifest))",
      "dest": "frontend/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/build/index.html"
    }
  ]
}
